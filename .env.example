# Configuration de la base de données PostgreSQL
POSTGRES_USER=obrail
POSTGRES_PASSWORD=obrail_dbpw
POSTGRES_DB=obrail_db

# DATABASE_URL pour Docker (utilisé par les conteneurs api, dashboard, etl)
DATABASE_URL=postgresql://obrail:obrail_dbpw@database:5432/obrail_db

# Pour une exécution locale (hors Docker), utilisez :
# DATABASE_URL=postgresql://obrail:obrail_dbpw@localhost:5433/obrail_db

# Configuration de l'API
API_PORT=8000
API_HOST=0.0.0.0

# Configuration du Dashboard
DASHBOARD_PORT=8501

# Mode (development, production)
MODE=development

# ---------------------------------------------------------------
# Veille technologique — sources externes
# ---------------------------------------------------------------

# NewsAPI (https://newsapi.org) — clé gratuite 100 req/jour
NEWSAPI_KEY=

# Google Alerts — URLs RSS exportées depuis https://www.google.com/alerts
# Séparer plusieurs URLs par des virgules
GOOGLE_ALERTS_RSS_URLS=

# Feedly Developer API (https://feedly.com/v3/auth/dev)
# Token personnel — usage personnel uniquement sur le plan gratuit
FEEDLY_TOKEN=
# IDs de stream Feedly séparés par des virgules
# Ex: feed/https://uic.org/news/rss.xml,user/<uid>/category/<catname>
FEEDLY_STREAM_IDS=

# Sources de veille activées (laisser vide = toutes)
# Valeurs possibles: google_alerts,rss,newsapi,hackernews,reddit,feedly
WATCH_ENABLED_SOURCES=
